{
  "name": "elc-conference-mcp-tickets",
  "version": "0.2.0",
  "type": "module",
  "description": "MCP server for ELC Conference 2027, the engineering leadership conference in Prague: tickets, what a ticket includes, and partnering with the conference (packages, add-ons, exact quotes, audience proof, offer request).",
  "mcpName": "io.github.marian-kamenistak/elc-conference-mcp-tickets",
  "main": "dist/index.js",
  "bin": {
    "elc-conference-mcp-tickets": "dist/index.js"
  },
  "scripts": {
    "build": "node scripts/sync-offer.mjs && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"const fs=require('fs');const f='dist/index.js';fs.writeFileSync(f,'#!/usr/bin/env node\\n'+fs.readFileSync(f,'utf8'))\" && chmod 755 dist/index.js",
    "dev": "wrangler dev",
    "start": "node dist/index.js",
    "deploy": "node scripts/sync-offer.mjs && wrangler deploy",
    "pretest": "npm run build",
    "test": "node --test dist/tests/*.test.js && vitest run",
    "sync-offer": "node scripts/sync-offer.mjs",
    "type-check": "tsc --noEmit -p tsconfig.worker.json",
    "cf-typegen": "wrangler types"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "ai",
    "conference",
    "tickets",
    "elc",
    "engineering-leadership",
    "prague",
    "cloudflare-workers",
    "partnership",
    "conference-partnership",
    "engineering-leaders",
    "cee"
  ],
  "homepage": "https://elc-conference.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/marian-kamenistak/elc-conference-mcp-tickets"
  },
  "author": "Marian Kamenistak <marian@engineeringleaders.io>",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@posthog/mcp": "0.11.7",
    "agents": "^0.9.0",
    "posthog-node": "5.51.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.80.0"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "!dist/tests",
    "README.md"
  ]
}
